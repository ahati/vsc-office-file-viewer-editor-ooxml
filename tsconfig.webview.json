{
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"types": [],
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noUnusedLocals": true,
		"baseUrl": ".",
		"paths": {
			"@betteroffice/vsdx": ["vendor/betteroffice/vsdx/src/index.ts"],
			"@betteroffice/vsdx-i18n": ["vendor/betteroffice/vsdx-i18n/src/index.ts"]
		}
	},
	"include": ["webview", "vendor/betteroffice/vsdx"],
	"exclude": [
		"node_modules",
		"out",
		".vscode-test",
		// Vendored reference copy of the upstream tsup config: not part of any build here, and it
		// imports `tsup`/`node:fs` which the webview program deliberately does not have (types: []).
		"vendor/betteroffice/vsdx/tsup.config.upstream.ts"
	]
}
