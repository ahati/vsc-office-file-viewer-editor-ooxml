{
  "name": "office-file-editor-viewer",
  "displayName": "Office File Editor & Viewer",
  "description": "Open Word, Excel, PowerPoint and Visio files with high-fidelity, fully offline WASM rendering — no telemetry.",
  "version": "0.1.1",
  "publisher": "ahati",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ahati/office-file-editor-viewer"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.js",
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "docx",
    "xlsx",
    "pptx",
    "vsdx",
    "visio",
    "office",
    "ooxml",
    "viewer",
    "wasm"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "officeFileViewer.docx",
        "displayName": "Office File Viewer (Word)",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.docx"
          },
          {
            "filenamePattern": "*.docm"
          }
        ]
      },
      {
        "viewType": "officeFileViewer.xlsx",
        "displayName": "Office File Viewer (Excel)",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xlsm"
          }
        ]
      },
      {
        "viewType": "officeFileViewer.pptx",
        "displayName": "Office File Viewer (PowerPoint)",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.pptx"
          },
          {
            "filenamePattern": "*.pptm"
          }
        ]
      },
      {
        "viewType": "officeFileViewer.vsdx",
        "displayName": "Office File Viewer (Visio)",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.vsdx"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "officeFileViewer.getDiagnostics",
        "title": "Office File Viewer: Show Diagnostics"
      },
      {
        "command": "officeFileViewer.reload",
        "title": "Office File Viewer: Reload Active Viewer"
      },
      {
        "command": "officeFileViewer.copyDiagnostics",
        "title": "Office File Viewer: Copy Diagnostics to Clipboard"
      }
    ],
    "configuration": {
      "title": "Office File Viewer",
      "properties": {
        "officeFileViewer.editing": {
          "type": "boolean",
          "default": true,
          "description": "Open OOXML files editable (editing ships in a later milestone; reserved)."
        },
        "officeFileViewer.fonts": {
          "type": "string",
          "enum": [
            "bundled",
            "off"
          ],
          "default": "bundled",
          "description": "Use bundled metric-compatible fonts for Office-accurate layout. 'off' uses system fonts only."
        },
        "officeFileViewer.cjkFonts": {
          "type": "string",
          "enum": [
            "off",
            "cdn"
          ],
          "default": "off",
          "description": "Fetch CJK font faces from the pinned open-source font CDN (jsDelivr). This is the only network access the extension can perform."
        },
        "officeFileViewer.initialZoom": {
          "type": "string",
          "enum": [
            "fitPage",
            "fitWidth",
            "100"
          ],
          "default": "fitPage",
          "description": "Initial zoom applied when a viewer opens."
        },
        "officeFileViewer.forceReadOnly": {
          "type": "boolean",
          "default": false,
          "description": "Always open documents read-only, regardless of the editing setting."
        },
        "officeFileViewer.colorMode": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "system"
          ],
          "default": "light",
          "description": "Editor chrome color mode for Word documents. The document canvas always stays Word-faithful (white)."
        }
      }
    },
    "languages": [
      {
        "id": "office-file-pptx",
        "extensions": [
          ".pptx",
          ".pptm"
        ],
        "icon": {
          "light": "./media/file-pptx.svg",
          "dark": "./media/file-pptx.svg"
        }
      },
      {
        "id": "office-file-vsdx",
        "extensions": [
          ".vsdx"
        ],
        "icon": {
          "light": "./media/file-vsdx.svg",
          "dark": "./media/file-vsdx.svg"
        }
      },
      {
        "id": "office-file-docx",
        "extensions": [
          ".docx",
          ".docm"
        ],
        "icon": {
          "light": "./media/file-docx.svg",
          "dark": "./media/file-docx.svg"
        }
      },
      {
        "id": "office-file-xlsx",
        "extensions": [
          ".xlsx",
          ".xlsm"
        ],
        "icon": {
          "light": "./media/file-xlsx.svg",
          "dark": "./media/file-xlsx.svg"
        }
      }
    ]
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs --production",
    "typecheck": "tsc -p ./ --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "npm run compile && node scripts/run-tests.mjs",
    "vscode:pretest": "npm run compile",
    "build:vsdx-wasm": "node scripts/build-vsdx-wasm.mjs"
  },
  "dependencies": {
    "@betteroffice/fonts": "0.4.0",
    "@betteroffice/pptx": "0.2.0",
    "@betteroffice/pptx-react": "0.2.0",
    "@betteroffice/xlsx": "0.3.0",
    "@betteroffice/xlsx-react": "0.3.0",
    "@docx-editor.dev/core": "^2.29.0",
    "@docx-editor.dev/react": "^2.29.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2"
  }
}
